[TEMPLATE]
# Psst environment variables.
#
# This single file at the repository root is shared by the Expo app and the
# backend in ./server (which loads it automatically in development), so a secret
# never needs to be duplicated. Copy to .env and fill in real values.
# .env is git-ignored — never commit it.

# ------------------------------------------------------------------ mobile app
# RevenueCat PUBLIC mobile SDK key. Safe to ship inside the app bundle.
EXPO_PUBLIC_REVENUECAT_API_KEY=your_public_revenuecat_sdk_key

# Public base URL of the Psst backend. Not a secret. Required for realtime mode;
# leave empty to keep the offline mock/demo engine.
# EXPO_PUBLIC_PSST_BACKEND_URL=https://your-psst-backend.example.com

# Optional shared access token, only needed when the backend sets
# PSST_CLIENT_TOKEN. Public value, not a secret — it ships in the app bundle.
# EXPO_PUBLIC_PSST_BACKEND_TOKEN=

# Optional engine pin: `realtime`/`live` or `mock`/`demo`. Leave unset to let the
# app choose (realtime when a backend URL is configured, demo without one).
# EXPO_PUBLIC_PSST_MODE=

# ------------------------------------------------------------- server-side only
# The two variables below are read ONLY by ./server. They are never bundled into
# the app, never logged, never returned from an endpoint and never sent to the
# client. Do NOT create EXPO_PUBLIC_ variants of them.

# ElevenLabs realtime speech-to-text.
# SERVER-SIDE SECRET. NEVER rename to EXPO_PUBLIC_ELEVENLABS_API_KEY.
ELEVENLABS_API_KEY=server_only_secret

# Sarvam AI conversation reasoning (the Psst cue engine).
# SERVER-SIDE SECRET. NEVER rename to EXPO_PUBLIC_SARVAM_API_KEY.
SARVAM_API_KEY=server_only_secret
