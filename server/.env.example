# Psst backend environment. Copy to .env (git-ignored) and fill in real values.
#
# In development you normally do NOT need this file: the backend automatically
# loads the repository-root ../.env, so the app and the server share one copy of
# each secret. This file is for a standalone deployment (for example under
# systemd on the Azure VM, where values come from an EnvironmentFile).
#
# Real environment variables always win over any .env file, so a production
# value can never be overridden by a leftover development file.

# HTTP/WS listen port and bind address.
PORT=8787
HOST=0.0.0.0

# Optional shared access token. When set, clients must connect with ?token=...
# Shipped to the app as EXPO_PUBLIC_PSST_BACKEND_TOKEN, so it is PUBLIC by
# construction: a throttle for a test backend, NOT authentication. Real
# authorization (entitlement checks) is a public-release gate.
PSST_CLIENT_TOKEN=

# SERVER-SIDE SECRET. Stays on this machine only.
# NEVER expose it to the app, never rename it to EXPO_PUBLIC_ELEVENLABS_API_KEY,
# never log it, never return it from an endpoint.
ELEVENLABS_API_KEY=server_only_secret
# Realtime STT model. Scribe Realtime v2 is the current realtime model.
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Commit strategy: vad (automatic on silence) or manual.
# ELEVENLABS_STT_COMMIT_STRATEGY=vad
# Optional spoken-language hint (ISO 639-1/639-3) to skip detection latency.
# ELEVENLABS_STT_LANGUAGE=
# Strip filler words and disfluencies from the transcript (default true).
# ELEVENLABS_STT_NO_VERBATIM=true
# How long to wait for the provider handshake before declaring the stream dead.
# PSST_STT_OPEN_TIMEOUT_MS=10000
# How long finalization waits for the commit it asked the provider for.
# PSST_STT_FLUSH_TIMEOUT_MS=2500

# SERVER-SIDE SECRET. Stays on this machine only.
# NEVER expose it to the app, never rename it to EXPO_PUBLIC_SARVAM_API_KEY.
SARVAM_API_KEY=server_only_secret
# SARVAM_MODEL=sarvam-105b-conversations
# low keeps cue latency down; raise to medium/high if cue quality matters more.
# SARVAM_REASONING_EFFORT=low
# SARVAM_TIMEOUT_MS=8000

# Minimum gap between two Psst cues, in milliseconds. Favours silence.
# PSST_MIN_CUE_INTERVAL_MS=12000
# Budget for the model-written recap before falling back to the transcript.
# Must stay comfortably below the app's 12s wait for the recap frame.
# PSST_RECAP_TIMEOUT_MS=10000

# Server-side limits. Each one is optional; /health reports the effective value.
# Keep PSST_MAX_PROVIDER_QUEUE_BYTES above PSST_MAX_AUDIO_FRAME_BYTES (base64 is
# ~4/3 of the payload) or a single frame will not fit in the pre-open queue.
# PSST_MAX_PAYLOAD_BYTES=262144           # one WebSocket message
# PSST_MAX_AUDIO_FRAME_BYTES=65536        # decoded PCM per audio.frame
# PSST_MAX_SESSION_AUDIO_BYTES=100663296  # total audio per session
# PSST_MAX_PROVIDER_QUEUE_BYTES=524288    # audio waiting for the provider
# PSST_PROVIDER_QUEUE_MAX_AGE_MS=4000     # age of that queued audio
# PSST_MAX_PROVIDER_BUFFERED_BYTES=524288 # unsent bytes on the provider socket
# PSST_MAX_SESSIONS=64                    # concurrent sessions
# PSST_IDLE_TIMEOUT_MS=180000             # silence before a session is ended
# PSST_MAX_SESSION_DURATION_MS=3600000    # hard ceiling on one session
# PSST_MAX_MESSAGES_PER_SEC=300           # audio frames per second
